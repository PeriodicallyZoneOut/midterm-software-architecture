# Static production build; all Node.js tooling stays inside Docker.
ARG BUILD_IMAGE=node:22-bookworm-slim
FROM ${BUILD_IMAGE} AS build
USER root
WORKDIR /app

# The project's prebuild scripts use git, bash and Python for generated assets.
RUN if ! command -v git || ! command -v python3; then \
        apt-get update \
        && apt-get install -y --no-install-recommends git python3 ca-certificates \
        && rm -rf /var/lib/apt/lists/*; \
    fi \
    && corepack enable

COPY package.json pnpm-lock.yaml ./
COPY scripts/configure-git-hooks.js ./scripts/configure-git-hooks.js
RUN corepack prepare pnpm@10.16.1 --activate \
    && pnpm install --frozen-lockfile

COPY . .

# Only public browser configuration belongs in build arguments. No DB secrets.
ARG NEXT_PUBLIC_SUPABASE_URL=""
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY=""
ARG NEXT_PUBLIC_SITE_URL=http://localhost:8080
ARG NEXT_PUBLIC_DEPLOY_URL=http://localhost:8080
ENV NEXT_PUBLIC_SUPABASE_URL=${NEXT_PUBLIC_SUPABASE_URL} \
    NEXT_PUBLIC_SUPABASE_ANON_KEY=${NEXT_PUBLIC_SUPABASE_ANON_KEY} \
    NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL} \
    NEXT_PUBLIC_DEPLOY_URL=${NEXT_PUBLIC_DEPLOY_URL} \
    NEXT_PUBLIC_PROJECT_NAME=ScriptHammer \
    NEXT_PUBLIC_PROJECT_OWNER=TortoiseWolfe \
    NEXT_PUBLIC_BASE_PATH="" \
    DISABLE_BASE_PATH=true \
    NEXT_TELEMETRY_DISABLED=1
RUN pnpm build

FROM nginx:stable-alpine@sha256:0e52bd054126cdc040b1276c0af347aeb02a41b9cfe305d6094767ac30e97949 AS web
COPY docker/nginx-static.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/out /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/ || exit 1
